FROM python:3.11-slim

WORKDIR /app

# Copy requirements trước để tận dụng cache
COPY ./Report/requirements.txt /app/requirements.txt


# Cài đặt các dependencies
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy toàn bộ source code
COPY ./jwt_shared /app/jwt_shared
COPY ./Session /app/Session

EXPOSE 8006

# Chạy migrate rồi khởi động uvicorn
CMD ["sh", "-c", "alembic -c Session/alembic.ini upgrade head && uvicorn Session.controller.main:app --host 0.0.0.0 --port 8006 --reload"]
